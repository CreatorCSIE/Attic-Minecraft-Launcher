{
  "name": "attic-launcher",
  "version": "0.0.8",
  "private": true,
  "attic": {
    "nightlyBase": "0.1.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "fixtures": "node scripts/emit-contract-fixtures.mjs",
    "fixtures:check": "node scripts/emit-contract-fixtures.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "gate:node16": "node scripts/node16-api-gate.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
