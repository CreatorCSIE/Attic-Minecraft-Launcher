{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attic Minecraft Launcher",
  "version": "0.0.0",
  "identifier": "uk.attic.launcher",
  "build": {
    "devUrl": "http://localhost:5310",
    "beforeDevCommand": "pnpm -C ../../packages/ui exec vite --port 5310 --strictPort",
    "beforeBuildCommand": "pnpm -C ../.. -r build",
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Attic Minecraft Launcher",
        "width": 980,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "backgroundColor": [20, 18, 15, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/server.cjs": "sidecar/server.cjs"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "110.0.1531.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MTU5MEVDNjcyMTA2REEKUldUYUJpRm43SkFWWjBiTEtldVRwWFNDbFI1L0RyaGZzd2htWXRPc0g5MEkwMmFjTmhadERPVGoK",
      "endpoints": [
        "https://github.com/CreatorCSIE/Attic-Minecraft-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
