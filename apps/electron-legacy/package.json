{
  "name": "@attic/electron-legacy",
  "version": "0.0.9",
  "private": true,
  "description": "Win7/8/8.1 兜底壳：Electron 22（Chromium 108 / Node 16.17）+ electron-builder --dir + Inno Setup（installer/attic.iss legacy flavor）；复用 apps/electron 主入口源码（esbuild 单文件化 + electron.net fetch 桥）",
  "main": "dist/legacy-main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/bundle.mjs",
    "dist": "node scripts/bundle.mjs && electron-builder --win --dir --x64 --ia32"
  },
  "dependencies": {
    "@attic/core-spec": "workspace:*",
    "@attic/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "~22.3.25",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
