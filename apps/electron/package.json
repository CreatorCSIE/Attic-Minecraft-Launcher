{
  "name": "@attic/electron",
  "version": "0.0.2",
  "private": true,
  "description": "Electron 壳（双壳并进第二发行形态 + 日常开发壳）：无边距主窗 + 加载 @attic/ui + IPC 骨架；Windows 发行 = tsc 直出 + electron-builder --dir + Inno（installer/attic.iss electron flavor）",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "electron . --dev-url=http://localhost:5310",
    "dist": "tsc -p tsconfig.json && electron-builder --win --dir"
  },
  "dependencies": {
    "@attic/core-spec": "workspace:*",
    "@attic/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3"
  }
}
