    "dev": "electron . --dev-url=http://localhost:5173"
  },
  "dependencies": {
    "@attic/core-spec": "workspace:*",
    "@attic/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "typescript": "^5.6.3"
  }
}
