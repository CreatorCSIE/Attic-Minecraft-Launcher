{
  "name": "@attic/electron",
  "version": "0.0.0",
  "private": true,
  "description": "Electron 壳（开发参考实现）：无边距主窗 + 加载 @attic/ui + IPC 骨架",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
